; Square wave / duty cycle generator. One state machine drives one pin.
;
; Before the state machine is enabled, the C++ side loads:
;   Y   = high phase loop count
;   ISR = low phase loop count
; (see square_output.cpp). The registers are never modified by the program,
; so the waveform repeats forever with no CPU or DMA involvement.
;
; Timing per phase: `mov` (1 cycle) + `jmp x--` executed count+1 times,
; so high time = Y + 2 cycles and low time = ISR + 2 cycles.
; Side-set drives the pin on every instruction, so edges land exactly on the
; first instruction of each phase.

.program square_wave
.side_set 1

.wrap_target
    mov x, y            side 1  ; start high phase, reload counter
high_loop:
    jmp x-- high_loop   side 1
    mov x, isr          side 0  ; start low phase, reload counter
low_loop:
    jmp x-- low_loop    side 0
.wrap
